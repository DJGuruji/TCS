import java.util.ArrayList;
import java.util.Collections;

public class ArrayListFunctionsExample {
    public static void main(String[] args) {
        // 1. Create an ArrayList
        ArrayList<Integer> list = new ArrayList<>();

        // 2. Add elements to the ArrayList
        list.add(10);  // Adds element at the end
        list.add(20);
        list.add(30);
        list.add(40);
        System.out.println("ArrayList after adding elements: " + list); // Output: [10, 20, 30, 40]

        // 3. Add element at a specific index
        list.add(2, 25);
        System.out.println("After adding 25 at index 2: " + list); // Output: [10, 20, 25, 30, 40]

        // 4. Get element at a specific index
        int value = list.get(2);
        System.out.println("Element at index 2: " + value); // Output: 25

        // 5. Remove element at a specific index
        list.remove(2);
        System.out.println("After removing element at index 2: " + list); // Output: [10, 20, 30, 40]

        // 6. Remove a specific element
        list.remove(Integer.valueOf(30)); 
        System.out.println("After removing element 30: " + list); // Output: [10, 20, 40]

        // 7. Set (replace) an element at a specific index
        list.set(1, 50);
        System.out.println("After setting index 1 to 50: " + list); // Output: [10, 50, 40]

        // 8. Check if an element exists
        boolean contains = list.contains(50);
        System.out.println("Does ArrayList contain 50? " + contains); // Output: true

        // 9. Find the size of the ArrayList
        int size = list.size();
        System.out.println("Size of ArrayList: " + size); // Output: 3

        // 10. Check if the ArrayList is empty
        boolean isEmpty = list.isEmpty();
        System.out.println("Is ArrayList empty? " + isEmpty); // Output: false

        // 11. Iterate using for-each loop
        System.out.println("Iterating over ArrayList:");
        for (Integer num : list) {
            System.out.println(num);
        }

        // 12. Sort the ArrayList
        list.add(5);
        Collections.sort(list);
        System.out.println("Sorted ArrayList: " + list); // Output: [5, 10, 40, 50]

        // 13. Convert ArrayList to Array
        Object[] array = list.toArray();
        System.out.println("ArrayList as an Array: " + java.util.Arrays.toString(array)); // Output: [5, 10, 40, 50]

        // 14. Add all elements from another collection
        ArrayList<Integer> anotherList = new ArrayList<>();
        anotherList.add(60);
        anotherList.add(70);
        list.addAll(anotherList);
        System.out.println("After adding all from anotherList: " + list); // Output: [5, 10, 40, 50, 60, 70]

        // 15. Remove all elements in another collection
        list.removeAll(anotherList);
        System.out.println("After removing all in anotherList: " + list); // Output: [5, 10, 40, 50]

        // 16. Clear the ArrayList
        list.clear();
        System.out.println("ArrayList after clearing: " + list); // Output: []

        // 17. Initialize with initial capacity
        ArrayList<String> stringList = new ArrayList<>(5);
        stringList.add("A");
        stringList.add("B");
        System.out.println("ArrayList with initial capacity: " + stringList); // Output: [A, B]

        // 18. Trim to size (reduces capacity to match size)
        stringList.trimToSize();
        System.out.println("After trimming to size: " + stringList);

        // 19. Check equality
        ArrayList<Integer> list1 = new ArrayList<>(java.util.Arrays.asList(1, 2, 3));
        ArrayList<Integer> list2 = new ArrayList<>(java.util.Arrays.asList(1, 2, 3));
        System.out.println("Are list1 and list2 equal? " + list1.equals(list2)); // Output: true
    }
}

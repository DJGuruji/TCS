import java.util.Arrays;

public class ArraysFunctionsExample {
    public static void main(String[] args) {
        // 1. Convert an array to a string
        int[] arr = {10, 20, 30, 40, 50};
        String arrString = Arrays.toString(arr);
        System.out.println("Array as String: " + arrString); // Output: [10, 20, 30, 40, 50]

        // 2. Sort an array in ascending order
        Arrays.sort(arr);
        System.out.println("Sorted Array: " + Arrays.toString(arr)); // Output: [10, 20, 30, 40, 50]

        // 3. Binary search for an element in a sorted array
        int index = Arrays.binarySearch(arr, 30);
        System.out.println("Index of 30: " + index); // Output: 2

        // 4. Fill an array with a specific value
        Arrays.fill(arr, 100);
        System.out.println("Array after fill: " + Arrays.toString(arr)); // Output: [100, 100, 100, 100, 100]

        // 5. Copy an array
        int[] copiedArray = Arrays.copyOf(arr, 7);
        System.out.println("Copied Array: " + Arrays.toString(copiedArray)); // Output: [100, 100, 100, 100, 100, 0, 0]

        // 6. Copy part of an array (from index 1 to 4)
        int[] copiedPart = Arrays.copyOfRange(arr, 1, 4);
        System.out.println("Copied Part of Array: " + Arrays.toString(copiedPart)); // Output: [100, 100, 100]

        // 7. Check if two arrays are equal
        int[] arr2 = {100, 100, 100, 100, 100};
        boolean isEqual = Arrays.equals(arr, arr2);
        System.out.println("Arrays are equal: " + isEqual); // Output: true

        // 8. Fill an array with specific value from index 2 to the end
        Arrays.fill(arr, 2, 4, 200);
        System.out.println("Array after filling range: " + Arrays.toString(arr)); // Output: [100, 100, 200, 200, 100]

        // 9. Compare two arrays
        int[] arr3 = {1, 2, 3, 4};
        int comparisonResult = Arrays.compare(arr, arr3);
        System.out.println("Comparison result: " + comparisonResult); // Output: -1 (because 100 < 1)

        // 10. Check if an array contains a specific element (using binary search)
        int searchResult = Arrays.binarySearch(arr, 200);
        System.out.println("Binary search result for 200: " + searchResult); // Output: 2 (index of 200 in sorted array)

        // 11. Sort a multidimensional array (2D)
        int[][] matrix = {{4, 2, 3}, {1, 6, 5}, {9, 8, 7}};
        for (int i = 0; i < matrix.length; i++) {
            Arrays.sort(matrix[i]); // Sorting each row
        }
        System.out.println("Sorted 2D array:");
        for (int[] row : matrix) {
            System.out.println(Arrays.toString(row)); // Sorted rows
        }
        // Output: 
        // [2, 3, 4]
        // [1, 5, 6]
        // [7, 8, 9]

        // 12. Fill an array with random values (using a custom logic)
        int[] randomArr = new int[5];
        for (int i = 0; i < randomArr.length; i++) {
            randomArr[i] = (int) (Math.random() * 100); // Generating random numbers between 0 and 100
        }
        System.out.println("Random Array: " + Arrays.toString(randomArr));
    }
}
